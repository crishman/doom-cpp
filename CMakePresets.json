{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug + ASan/UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "DOOM_LEGACY_WARNINGS": "OFF",
        "DOOM_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "rel",
      "inherits": "base",
      "displayName": "RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DOOM_LEGACY_WARNINGS": "OFF",
        "DOOM_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "warn",
      "inherits": "dev",
      "displayName": "Debug + strict warnings as errors",
      "cacheVariables": {
        "DOOM_LEGACY_WARNINGS": "ON",
        "DOOM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev-clang",
      "inherits": "dev",
      "displayName": "Debug + ASan/UBSan (clang)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "rel-clang",
      "inherits": "rel",
      "displayName": "RelWithDebInfo (clang)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "warn-clang",
      "inherits": "warn",
      "displayName": "Debug + strict warnings as errors (clang)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "rel",
      "configurePreset": "rel"
    },
    {
      "name": "warn",
      "configurePreset": "warn"
    },
    {
      "name": "dev-clang",
      "configurePreset": "dev-clang"
    },
    {
      "name": "rel-clang",
      "configurePreset": "rel-clang"
    },
    {
      "name": "warn-clang",
      "configurePreset": "warn-clang"
    }
  ]
}
